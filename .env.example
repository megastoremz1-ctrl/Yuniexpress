# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yuniexpress"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
AUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AliExpress API
ALIEXPRESS_APP_KEY="your-aliexpress-app-key"
ALIEXPRESS_APP_SECRET="your-aliexpress-app-secret"
ALIEXPRESS_ACCESS_TOKEN="your-aliexpress-access-token"
ALIEXPRESS_TRACKING_ID="your-affiliate-tracking-id"

# PayGo Payment Gateway
PAYGO_API_KEY="your-paygo-api-key"
PAYGO_API_SECRET="your-paygo-api-secret"
PAYGO_MERCHANT_ID="your-paygo-merchant-id"
PAYGO_CALLBACK_URL="http://localhost:3000/api/payments/callback"

# Exchange Rate API (https://exchangeratesapi.io or similar)
EXCHANGE_RATE_API_KEY="your-exchange-rate-api-key"

# OneSignal Push Notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID="your-onesignal-app-id"
ONESIGNAL_REST_API_KEY="your-onesignal-rest-api-key"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="YuniExpress"
DEFAULT_MARGIN_PERCENT="25"
SYNC_INTERVAL_MINUTES="30"

# Cron Secret (for protecting cron endpoints)
CRON_SECRET="generate-a-secret-with-openssl-rand-base64-32"
